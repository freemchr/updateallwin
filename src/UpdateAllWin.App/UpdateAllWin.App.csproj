<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(WindowsTfm)</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>UpdateAllWin.App</RootNamespace>
    <AssemblyName>UpdateAllWin</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\UpdateAllWin.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged, self-contained: the installer ships everything, no Store/MSIX dependency. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <!-- Custom Main for single-instance + elevated helper modes. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <None Remove="Assets\logo-paths.txt" />
    <Content Remove="Assets\logo-paths.txt" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\UpdateAllWin.Toolbar\UpdateAllWin.Toolbar.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <!-- dotnet publish of an unpackaged WinUI app omits the app's own resources.pri and compiled XAML
       (.xbf), so the window fails to load with a XamlParseException. Publish them explicitly. -->
  <Target Name="PublishAppPriAndXbf" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_AppXamlResource Include="$(OutDir)$(TargetName).pri;$(OutDir)**\*.xbf" />
      <ResolvedFileToPublish Include="@(_AppXamlResource)"
                             RelativePath="%(RecursiveDir)%(Filename)%(Extension)"
                             CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
