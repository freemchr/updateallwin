<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="UpdateAllWin.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolbar="using:UpdateAllWin.Toolbar"
    xmlns:vm="using:UpdateAllWin.App.ViewModels"
    Title="UpdateAll Win">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar: logo + wordmark, like the Windows 11 Settings app -->
        <Grid x:Name="AppTitleBar" Background="Transparent" Padding="16,0,140,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <toolbar:LogoMark Width="28" Height="28" />
                <TextBlock VerticalAlignment="Center" FontSize="16">
                    <Run Text="UpdateAll" FontWeight="SemiBold" /><Run Text=" Win" Foreground="{ThemeResource BrandBlueBrush}" />
                </TextBlock>
                <Border Visibility="{x:Bind vm:Format.Visible(ViewModel.SimulationMode), Mode=OneWay}"
                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                    <TextBlock Text="Simulation mode" FontSize="12" />
                </Border>
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneToggleButtonVisible="False"
            OpenPaneLength="236"
            SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Tag="dashboard" IsSelected="True">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Available Updates" Tag="updates">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE896;" /></NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Value="{x:Bind ViewModel.AvailableCount, Mode=OneWay}"
                                   Visibility="{x:Bind vm:Format.VisibleIfAny(ViewModel.AvailableCount), Mode=OneWay}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem Content="History" Tag="history">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Automation" Tag="automation">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Settings" Tag="settings">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9E9;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="16,8,16,16">
                    <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <StackPanel>
                        <TextBlock Text="UpdateAll Win" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </NavigationView.PaneFooter>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <InfoBar
                    Grid.Row="0"
                    Margin="24,16,24,0"
                    IsOpen="{x:Bind ViewModel.ServiceMissing, Mode=OneWay}"
                    IsClosable="False"
                    Severity="Warning"
                    Title="The UpdateAll Win service isn't running"
                    Message="The background service checks for and installs updates. Start it (administrator approval required).">
                    <InfoBar.ActionButton>
                        <Button Content="Start service" Click="StartService_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <Frame x:Name="ContentFrame" Grid.Row="1" />

                <!-- Restart banner (all pages) -->
                <Border Grid.Row="2" Margin="24,0,24,20" Padding="20,14" CornerRadius="10"
                        Background="{ThemeResource RestartBannerBrush}" BorderBrush="{ThemeResource RestartBannerStrokeBrush}" BorderThickness="1"
                        Visibility="{x:Bind vm:Format.Visible(ViewModel.RestartPending), Mode=OneWay}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="40" Height="40">
                            <Ellipse Fill="#F5A623" />
                            <TextBlock Text="!" FontSize="22" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Restart required to finish updates" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.RestartBannerText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="Restart later" Click="RestartLater_Click" MinWidth="110"
                                    Visibility="{x:Bind vm:Format.Visible(ViewModel.CanDeferRestart), Mode=OneWay}" />
                            <Button Content="Restart now" Style="{StaticResource AccentButtonStyle}" Click="RestartNow_Click" MinWidth="110" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
