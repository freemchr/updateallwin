<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="UpdateAllWin.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:UpdateAllWin.App.Controls"
    xmlns:toolbar="using:UpdateAllWin.Toolbar"
    xmlns:vm="using:UpdateAllWin.App.ViewModels"
    Title="UpdateAll Win">

    <!-- One simple window: status, one action, machine details. -->
    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Status-coloured strip down the left edge -->
        <Rectangle Grid.RowSpan="2" Fill="{x:Bind ViewModel.AccentBrush, Mode=OneWay}" />

        <!-- Drag area / title bar -->
        <Grid x:Name="AppTitleBar" Grid.Column="1" Background="Transparent" Padding="16,0,140,0">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <toolbar:LogoMark Width="18" Height="18" />
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center">
                    <Run Text="UpdateAll" FontWeight="SemiBold" /><Run Text=" Win" Foreground="{ThemeResource BrandBlueBrush}" />
                </TextBlock>
                <Border Visibility="{x:Bind vm:Format.Visible(ViewModel.SimulationMode), Mode=OneWay}"
                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                    <TextBlock Text="Simulation mode" FontSize="11" />
                </Border>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Grid.Column="1">
            <StackPanel Padding="28,8,28,20" Spacing="18">

                <!-- Header: manufacturer logo + title -->
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:ManufacturerLogo Manufacturer="{x:Bind ViewModel.DeviceManufacturer, Mode=OneWay}" Width="72" Height="72" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <!-- Message -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}" TextWrapping="Wrap" />
                        <StackPanel Spacing="6" Visibility="{x:Bind vm:Format.Visible(ViewModel.IsBusy), Mode=OneWay}">
                            <ProgressBar Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" IsIndeterminate="{x:Bind ViewModel.ProgressIndeterminate, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Action buttons: only the ones that make sense right now -->
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <Button Grid.ColumnSpan="2" Content="Start service" Click="StartService_Click" Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch" MinHeight="44" Visibility="{x:Bind vm:Format.Visible(ViewModel.ShowStartService), Mode=OneWay}" />

                    <Button Grid.ColumnSpan="2" Content="Cancel" Click="Cancel_Click"
                            HorizontalAlignment="Stretch" MinHeight="44" Visibility="{x:Bind vm:Format.Visible(ViewModel.ShowCancel), Mode=OneWay}" />

                    <Button Content="Restart Now" Click="RestartNow_Click" Style="{StaticResource AccentButtonStyle}"
                            Grid.ColumnSpan="{x:Bind ViewModel.RestartNowSpan, Mode=OneWay}"
                            HorizontalAlignment="Stretch" MinHeight="44" Visibility="{x:Bind vm:Format.Visible(ViewModel.ShowRestart), Mode=OneWay}" />
                    <Button Grid.Column="1" Content="Restart Later" Click="RestartLater_Click"
                            HorizontalAlignment="Stretch" MinHeight="44" Visibility="{x:Bind vm:Format.Visible(ViewModel.ShowRestartLater), Mode=OneWay}" />

                    <Button Content="Review BIOS update" Click="Review_Click"
                            HorizontalAlignment="Stretch" MinHeight="44" Visibility="{x:Bind vm:Format.Visible(ViewModel.ShowReview), Mode=OneWay}" />
                    <Button Grid.Column="{x:Bind ViewModel.UpdateAllColumn, Mode=OneWay}" Grid.ColumnSpan="{x:Bind ViewModel.UpdateAllSpan, Mode=OneWay}"
                            Click="UpdateAll_Click" Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch" MinHeight="44" Visibility="{x:Bind vm:Format.Visible(ViewModel.ShowUpdateAll), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE896;" FontSize="16" /><TextBlock Text="Update All" FontWeight="SemiBold" /></StackPanel>
                    </Button>
                </Grid>

                <!-- Machine details -->
                <Border Style="{StaticResource CardStyle}" Padding="20,14" Visibility="{x:Bind vm:Format.Visible(ViewModel.HasDevice), Mode=OneWay}">
                    <Grid ColumnSpacing="16" RowSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Windows" Style="{StaticResource DetailLabelStyle}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.OsText, Mode=OneWay}" Style="{StaticResource DetailValueStyle}" />
                        <TextBlock Grid.Row="1" Text="Processor" Style="{StaticResource DetailLabelStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.CpuText, Mode=OneWay}" Style="{StaticResource DetailValueStyle}" />
                        <TextBlock Grid.Row="2" Text="Memory" Style="{StaticResource DetailLabelStyle}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.MemoryText, Mode=OneWay}" Style="{StaticResource DetailValueStyle}" />
                        <TextBlock Grid.Row="3" Text="BIOS" Style="{StaticResource DetailLabelStyle}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.BiosText, Mode=OneWay}" Style="{StaticResource DetailValueStyle}" />
                        <TextBlock Grid.Row="4" Text="Serial" Style="{StaticResource DetailLabelStyle}" />
                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.SerialText, Mode=OneWay}" Style="{StaticResource DetailValueStyle}" IsTextSelectionEnabled="True" />
                            <Button Padding="4,0" Background="Transparent" BorderThickness="0" Click="ToggleSerial_Click" ToolTipService.ToolTip="Show or hide serial number">
                                <FontIcon Glyph="&#xE7B3;" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Footer -->
                <Grid>
                    <HyperlinkButton Padding="0" Click="ShowInstalled_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE81C;" FontSize="14" /><TextBlock Text="What was installed" /></StackPanel>
                    </HyperlinkButton>
                    <TextBlock x:Name="VersionText" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
