<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UpdateAllWin.App.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:UpdateAllWin.App.ViewModels"
    xmlns:controls="using:UpdateAllWin.App.Controls"
    NavigationCacheMode="Required">

    <ScrollViewer>
        <StackPanel Padding="24,20,24,20" Spacing="16" MaxWidth="1200">

            <!-- Status card -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="76" Height="76" VerticalAlignment="Center">
                        <Ellipse Fill="{x:Bind ViewModel.HeroBackgroundBrush, Mode=OneWay}" />
                        <FontIcon Glyph="{x:Bind ViewModel.HeroGlyph, Mode=OneWay}" FontSize="34" Foreground="{x:Bind ViewModel.HeroBrush, Mode=OneWay}"
                                  Visibility="{x:Bind vm:Format.Collapsed(ViewModel.IsBusy), Mode=OneWay}" />
                        <ProgressRing Width="44" Height="44" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                      Visibility="{x:Bind vm:Format.Visible(ViewModel.IsBusy), Mode=OneWay}" />
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.HeroTitle, Mode=OneWay}" FontSize="28" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind ViewModel.HeroSubtitle, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" MaxLines="3" />
                        <Button Click="Review_Click" Margin="0,10,0,0" Padding="14,6" HorizontalAlignment="Left"
                                Visibility="{x:Bind vm:Format.VisibleIfAny(ViewModel.AwaitingApprovalCount), Mode=OneWay}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8FB;" FontSize="16" /><TextBlock Text="Review BIOS update" /></StackPanel>
                        </Button>
                        <StackPanel Spacing="4" Margin="0,8,0,0" Visibility="{x:Bind vm:Format.Visible(ViewModel.IsBusy), Mode=OneWay}">
                            <ProgressBar Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" IsIndeterminate="{x:Bind ViewModel.ProgressIndeterminate, Mode=OneWay}" MaxWidth="520" HorizontalAlignment="Stretch" />
                            <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button Click="Cancel_Click" MinHeight="44" Padding="20,0" Visibility="{x:Bind vm:Format.Visible(ViewModel.IsBusy), Mode=OneWay}" Content="Cancel" />
                        <Button Click="Check_Click" MinHeight="44" Padding="20,0" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE72C;" FontSize="16" /><TextBlock Text="Check for Updates" /></StackPanel>
                        </Button>
                        <Button Click="UpdateAll_Click" MinHeight="44" Padding="24,0" Style="{StaticResource AccentButtonStyle}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE896;" FontSize="16" /><TextBlock Text="Update All" FontWeight="SemiBold" /></StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Device card -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>

                    <!-- Device illustration (vector) -->
                    <Viewbox Width="190" Height="130" VerticalAlignment="Center">
                        <Canvas Width="190" Height="130">
                            <Rectangle Canvas.Left="22" Canvas.Top="6" Width="146" Height="100" RadiusX="6" RadiusY="6" Fill="#1C1C1E" />
                            <Rectangle Canvas.Left="28" Canvas.Top="12" Width="134" Height="86" RadiusX="2" RadiusY="2">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#9CC7FF" Offset="0" />
                                        <GradientStop Color="#2D6BF2" Offset="0.55" />
                                        <GradientStop Color="#0A2A8C" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Path Fill="#66FFFFFF" Data="M60,98 C70,60 110,40 150,30 C130,55 120,80 128,98 Z" />
                            <Path Fill="#33FFFFFF" Data="M40,98 C60,70 100,55 140,52 C110,70 100,85 104,98 Z" />
                            <Path Data="M8,108 L182,108 L176,118 C175,120 173,121 170,121 L20,121 C17,121 15,120 14,118 Z">
                                <Path.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#E3E6EA" Offset="0" />
                                        <GradientStop Color="#A9AFB7" Offset="1" />
                                    </LinearGradientBrush>
                                </Path.Fill>
                            </Path>
                            <Rectangle Canvas.Left="80" Canvas.Top="108" Width="30" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#8C939C" />
                        </Canvas>
                    </Viewbox>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="{x:Bind ViewModel.DeviceModel, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.DeviceManufacturer, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,8" />
                        <TextBlock Text="{x:Bind ViewModel.OsText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.CpuText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}">
                            <Run Text="{x:Bind ViewModel.RamText, Mode=OneWay}" /><Run Text="   ·   " /><Run Text="{x:Bind ViewModel.StorageText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{x:Bind ViewModel.BiosText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.SerialText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                            <Button Padding="4" Background="Transparent" BorderThickness="0" Click="ToggleSerial_Click" ToolTipService.ToolTip="Show or hide serial number">
                                <FontIcon Glyph="&#xE7B3;" FontSize="13" />
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <Rectangle Grid.Column="2" Width="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,8" />

                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="6">
                        <controls:ManufacturerLogo Manufacturer="{x:Bind ViewModel.DeviceManufacturer, Mode=OneWay}" Width="120" Height="64" HorizontalAlignment="Left" Margin="0,0,0,6" />
                        <TextBlock Text="{x:Bind ViewModel.AvailableSummary, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.AvailableSummaryDetail, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.LastScanText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="Restart pending: " /><Run Text="{x:Bind ViewModel.RestartPendingText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Category cards -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Tag="drivers" Click="Category_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="20,16" CornerRadius="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border Width="48" Height="48" CornerRadius="10" Background="{ThemeResource IconTileBrush}" VerticalAlignment="Top">
                            <FontIcon Glyph="&#xE713;" FontSize="22" Foreground="{ThemeResource BrandBlueBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Drivers" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.DriverCount, Mode=OneWay}" FontSize="28" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.DriverCaption, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Button>

                <Button Grid.Column="1" Tag="bios" Click="Category_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="20,16" CornerRadius="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border Width="48" Height="48" CornerRadius="10" Background="{ThemeResource IconTileBrush}" VerticalAlignment="Top">
                            <FontIcon Glyph="&#xE950;" FontSize="22" Foreground="{ThemeResource BrandBlueBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="BIOS" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.BiosCount, Mode=OneWay}" FontSize="28" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.BiosCaption, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Button>

                <Button Grid.Column="2" Tag="firmware" Click="Category_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="20,16" CornerRadius="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border Width="48" Height="48" CornerRadius="10" Background="{ThemeResource IconTileBrush}" VerticalAlignment="Top">
                            <FontIcon Glyph="&#xE964;" FontSize="22" Foreground="{ThemeResource BrandBlueBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Firmware" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.FirmwareCount, Mode=OneWay}" FontSize="28" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.FirmwareCaption, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Button>
            </Grid>

            <!-- Available updates -->
            <Border Style="{StaticResource CardStyle}" Padding="0">
                <StackPanel>
                    <Grid Padding="24,18,24,10">
                        <TextBlock Text="{x:Bind ViewModel.AvailableHeader, Mode=OneWay}" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                            <HyperlinkButton Content="Select all" Click="SelectAll_Click" />
                            <HyperlinkButton Content="Clear" Click="ClearSelection_Click" />
                        </StackPanel>
                    </Grid>

                    <Grid Padding="24,6" ColumnSpacing="12" BorderBrush="{ThemeResource RowDividerBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" /><ColumnDefinition Width="28" /><ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="2" Text="Name" Style="{StaticResource ColumnHeaderStyle}" />
                        <TextBlock Grid.Column="3" Text="Type" Style="{StaticResource ColumnHeaderStyle}" />
                        <TextBlock Grid.Column="4" Text="Current Version" Style="{StaticResource ColumnHeaderStyle}" />
                        <TextBlock Grid.Column="5" Text="New Version" Style="{StaticResource ColumnHeaderStyle}" />
                        <TextBlock Grid.Column="6" Text="Size" Style="{StaticResource ColumnHeaderStyle}" />
                    </Grid>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.FilteredUpdates}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:UpdateItemViewModel">
                                <Grid Padding="24,10" ColumnSpacing="12" BorderBrush="{ThemeResource RowDividerBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" /><ColumnDefinition Width="28" /><ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox MinWidth="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind IsInstallable, Mode=OneWay}" VerticalAlignment="Center" />
                                    <FontIcon Grid.Column="1" Glyph="{x:Bind Glyph}" FontSize="18" Foreground="{ThemeResource BrandBlueBrush}" />
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind StateText, Mode=OneWay}" Foreground="{x:Bind StateBrush, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{x:Bind CategoryText}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind CurrentVersion}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind AvailableVersion}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="6" Text="{x:Bind SizeText}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Margin="24,18" Text="No updates to show. Click Check for Updates to scan your PC." Style="{StaticResource SecondaryTextStyle}"
                               Visibility="{x:Bind vm:Format.VisibleIfNone(ViewModel.AvailableCount), Mode=OneWay}" />

                    <Grid Padding="24,14,24,18">
                        <TextBlock Text="{x:Bind ViewModel.SourcesText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}" MinHeight="44" Padding="24,0" Click="InstallSelected_Click"
                                IsEnabled="{x:Bind ViewModel.CanInstallSelected, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE896;" FontSize="16" /><TextBlock Text="{x:Bind ViewModel.InstallSelectedText, Mode=OneWay}" FontWeight="SemiBold" /></StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
