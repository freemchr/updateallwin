<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UpdateAllWin.App.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:UpdateAllWin.App.ViewModels">

    <Grid Padding="24,20,24,12" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Update History" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Scans, installations, failures and restarts on this PC. Click an entry for details." Style="{StaticResource SecondaryTextStyle}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <ComboBox x:Name="KindFilter" SelectionChanged="KindFilter_SelectionChanged" MinWidth="180" SelectedIndex="0">
                <ComboBoxItem Content="All activity" Tag="" />
                <ComboBoxItem Content="Installations" Tag="Install" />
                <ComboBoxItem Content="Errors" Tag="Failure" />
                <ComboBoxItem Content="Scans" Tag="Scan" />
                <ComboBoxItem Content="Restarts" Tag="Restart" />
                <ComboBoxItem Content="BIOS approvals" Tag="Approval" />
            </ComboBox>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="14" /><TextBlock Text="Refresh" /></StackPanel>
                </Button>
                <Button Click="ExportCsv_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE9F9;" FontSize="14" /><TextBlock Text="Export CSV" /></StackPanel>
                </Button>
                <Button Click="ExportDiagnostics_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xEBE8;" FontSize="14" /><TextBlock Text="Export diagnostic logs" /></StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
            <ListView ItemsSource="{x:Bind ViewModel.History}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="History_ItemClick">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:HistoryItemViewModel">
                        <Grid Padding="4,10" ColumnSpacing="14" BorderBrush="{ThemeResource RowDividerBrush}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="2.5*" />
                                <ColumnDefinition Width="100" /><ColumnDefinition Width="110" /><ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="{x:Bind Glyph}" Foreground="{x:Bind GlyphBrush}" FontSize="16" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Versions}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Visibility="{x:Bind vm:Format.VisibleIfText(Versions)}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{x:Bind Result}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" Text="{x:Bind KindText}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="{x:Bind TriggerText}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="{x:Bind Time}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>
