<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UpdateAllWin.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:UpdateAllWin.App.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer>
            <StackPanel Padding="24,20,24,20" Spacing="4" MaxWidth="1000">
                <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />

                <!-- Per-user preferences: saved immediately -->
                <TextBlock Text="Your preferences" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,12,0,4" />
                <controls:SettingRow Header="Start with Windows" Description="Show the toolbar and notification-area icon when you sign in." Glyph="&#xE7E8;">
                    <ToggleSwitch x:Name="StartWithWindows" Toggled="Pref_Toggled" />
                </controls:SettingRow>
                <controls:SettingRow Header="Show floating toolbar" Description="The one-click “Update All” toolbar." Glyph="&#xE8A1;">
                    <ToggleSwitch x:Name="ShowToolbar" Toggled="Pref_Toggled" />
                </controls:SettingRow>
                <controls:SettingRow Header="Toolbar always on top" Glyph="&#xE718;">
                    <ToggleSwitch x:Name="AlwaysOnTop" Toggled="Pref_Toggled" />
                </controls:SettingRow>
                <controls:SettingRow Header="Minimise to system tray" Description="Closing this window keeps UpdateAll Win running in the notification area." Glyph="&#xE921;">
                    <ToggleSwitch x:Name="MinimizeToTray" Toggled="Pref_Toggled" />
                </controls:SettingRow>
                <controls:SettingRow Header="Restart notifications" Description="Remind me when a restart is needed to finish updates." Glyph="&#xEA8F;">
                    <ToggleSwitch x:Name="RestartNotifications" Toggled="Pref_Toggled" />
                </controls:SettingRow>
                <controls:SettingRow Header="Show serial number" Description="Privacy: the serial number is masked unless this is on." Glyph="&#xE72E;">
                    <ToggleSwitch x:Name="ShowSerial" Toggled="Pref_Toggled" />
                </controls:SettingRow>
                <controls:SettingRow Header="Appearance" Glyph="&#xE790;">
                    <ComboBox x:Name="Theme" SelectionChanged="Theme_SelectionChanged" MinWidth="160">
                        <ComboBoxItem Content="Use system setting" />
                        <ComboBoxItem Content="Light" />
                        <ComboBoxItem Content="Dark" />
                    </ComboBox>
                </controls:SettingRow>

                <!-- Machine policy: saved with administrator approval -->
                <TextBlock Text="Update policy for this PC" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,20,0,0" />
                <TextBlock Text="These apply to all users and need administrator approval to save." Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4" />
                <controls:SettingRow Header="Update types" Description="Which kinds of update to look for." Glyph="&#xE71C;">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <CheckBox Content="Drivers" IsChecked="{x:Bind ViewModel.Policy.IncludeDrivers, Mode=TwoWay}" MinWidth="0" />
                        <CheckBox Content="BIOS" IsChecked="{x:Bind ViewModel.Policy.IncludeBios, Mode=TwoWay}" MinWidth="0" />
                        <CheckBox Content="Firmware" IsChecked="{x:Bind ViewModel.Policy.IncludeFirmware, Mode=TwoWay}" MinWidth="0" />
                    </StackPanel>
                </controls:SettingRow>
                <controls:SettingRow Header="Install drivers automatically" Glyph="&#xE713;">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.Policy.AutoInstallDrivers, Mode=TwoWay}" />
                </controls:SettingRow>
                <controls:SettingRow Header="BIOS approval required" Description="Recommended. Turn off only for managed fleets with tested BIOS releases." Glyph="&#xE950;">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.Policy.BiosApprovalRequired, Mode=TwoWay}" />
                </controls:SettingRow>
                <controls:SettingRow Header="Critical updates only" Glyph="&#xE7BA;">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.Policy.CriticalOnly, Mode=TwoWay}" />
                </controls:SettingRow>
                <controls:SettingRow Header="Windows Update drivers" Description="Used for PCs without a supported manufacturer tool (ASUS, Acer, MSI, Surface…)." Glyph="&#xE895;">
                    <ComboBox SelectedIndex="{x:Bind ViewModel.Policy.WindowsUpdateIndex, Mode=TwoWay}" MinWidth="240">
                        <ComboBoxItem Content="Only when no manufacturer tool" />
                        <ComboBoxItem Content="Always, alongside manufacturer tool" />
                        <ComboBoxItem Content="Never" />
                    </ComboBox>
                </controls:SettingRow>
                <controls:SettingRow Header="Allow standard users to install updates" Description="Users without admin rights can use Update All. BIOS still needs approval." Glyph="&#xE716;">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.Policy.AllowStandardUsersToInstall, Mode=TwoWay}" />
                </controls:SettingRow>

                <TextBlock Text="Safety" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
                <controls:SettingRow Header="Create a restore point before installing" Glyph="&#xE81C;">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.Policy.CreateRestorePoint, Mode=TwoWay}" />
                </controls:SettingRow>
                <controls:SettingRow Header="Minimum free disk space (GB)" Glyph="&#xEDA2;">
                    <NumberBox Value="{x:Bind ViewModel.Policy.MinimumFreeSpaceGb, Mode=TwoWay}" Minimum="1" Maximum="500" SpinButtonPlacementMode="Compact" MinWidth="120" />
                </controls:SettingRow>
                <controls:SettingRow Header="Minimum battery for BIOS updates (%)" Description="AC power is always required for BIOS updates." Glyph="&#xE83F;">
                    <NumberBox Value="{x:Bind ViewModel.Policy.BiosMinimumBatteryPercent, Mode=TwoWay}" Minimum="20" Maximum="100" SpinButtonPlacementMode="Compact" MinWidth="120" />
                </controls:SettingRow>
                <controls:SettingRow Header="Suspend BitLocker for BIOS updates" Description="Suspends protection for one restart only, then it resumes automatically." Glyph="&#xE72E;">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.Policy.AllowBitLockerSuspension, Mode=TwoWay}" />
                </controls:SettingRow>
                <controls:SettingRow Header="Require a BitLocker recovery key" Description="Block BIOS updates if BitLocker is on but no recovery key exists." Glyph="&#xE8D7;">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.Policy.RequireBitLockerRecoveryKey, Mode=TwoWay}" />
                </controls:SettingRow>
                <controls:SettingRow Header="HP BIOS password file" Description="Encrypted password file from HP's HPQPswd tool, if the BIOS has an admin password." Glyph="&#xE8D7;">
                    <TextBox Text="{x:Bind ViewModel.Policy.HpBiosPasswordFile, Mode=TwoWay}" PlaceholderText="Not set" MinWidth="320" />
                </controls:SettingRow>

                <TextBlock Text="Storage and tools" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
                <controls:SettingRow Header="Download location" Description="Leave empty for %ProgramData%\UpdateAllWin\Downloads." Glyph="&#xE896;">
                    <TextBox Text="{x:Bind ViewModel.Policy.DownloadFolder, Mode=TwoWay}" PlaceholderText="Default" MinWidth="320" />
                </controls:SettingRow>
                <controls:SettingRow Header="HP Image Assistant location" Description="Leave empty to download and update HPIA automatically from HP. Must be under Program Files." Glyph="&#xE7EF;">
                    <TextBox Text="{x:Bind ViewModel.Policy.HpiaPath, Mode=TwoWay}" PlaceholderText="Automatic" MinWidth="320" />
                </controls:SettingRow>
                <controls:SettingRow Header="Log retention (days)" Glyph="&#xE81C;">
                    <NumberBox Value="{x:Bind ViewModel.Policy.LogRetentionDays, Mode=TwoWay}" Minimum="1" Maximum="3650" SpinButtonPlacementMode="Compact" MinWidth="120" />
                </controls:SettingRow>
                <controls:SettingRow Header="Delete settings and history when uninstalling" Glyph="&#xE74D;">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.Policy.RemoveDataOnUninstall, Mode=TwoWay}" />
                </controls:SettingRow>

                <TextBlock Text="Diagnostics" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
                <controls:SettingRow Header="Export diagnostic logs" Description="Creates a zip with logs, vendor reports and history (serial number masked)." Glyph="&#xEBE8;">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Open logs folder" Click="OpenLogs_Click" />
                        <Button Content="Export" Click="Export_Click" />
                    </StackPanel>
                </controls:SettingRow>
                <controls:SettingRow Header="Simulation mode (testing)" Description="Use simulated updates instead of real manufacturer tools. Nothing is installed." Glyph="&#xE7FC;">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox SelectedIndex="{x:Bind ViewModel.Policy.SimulationScenarioIndex, Mode=TwoWay}" MinWidth="180" IsEnabled="{x:Bind ViewModel.Policy.SimulationMode, Mode=OneWay}">
                            <ComboBoxItem Content="Updates available" />
                            <ComboBoxItem Content="Up to date" />
                            <ComboBoxItem Content="Download failure" />
                            <ComboBoxItem Content="Install failure" />
                            <ComboBoxItem Content="No network" />
                        </ComboBox>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.Policy.SimulationMode, Mode=TwoWay}" MinWidth="0" />
                    </StackPanel>
                </controls:SettingRow>

                <TextBlock Text="About" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
                <controls:SettingRow Header="UpdateAll Win" Description="{x:Bind AboutText}" Glyph="&#xE946;" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Padding="24,12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Discard policy changes" Click="Discard_Click" />
                <Button Style="{StaticResource AccentButtonStyle}" Click="Save_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xEA18;" FontSize="14" /><TextBlock Text="Save policy" /></StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>
