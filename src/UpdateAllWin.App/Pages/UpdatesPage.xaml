<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UpdateAllWin.App.Pages.UpdatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:UpdateAllWin.App.ViewModels">

    <Grid Padding="24,20,24,12" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="Available Updates" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{x:Bind ViewModel.SourcesText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" VerticalAlignment="Center">
                <Button Click="Check_Click" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="14" /><TextBlock Text="Check for Updates" /></StackPanel>
                </Button>
                <Button Click="UpdateAll_Click" Style="{StaticResource AccentButtonStyle}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE896;" FontSize="14" /><TextBlock Text="Update All" /></StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <SelectorBar x:Name="Filter" SelectionChanged="Filter_SelectionChanged">
                <SelectorBarItem Text="All" Tag="all" IsSelected="True" />
                <SelectorBarItem Text="Drivers" Tag="drivers" />
                <SelectorBarItem Text="BIOS" Tag="bios" />
                <SelectorBarItem Text="Firmware" Tag="firmware" />
            </SelectorBar>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <HyperlinkButton Content="Select all" Click="SelectAll_Click" />
                <HyperlinkButton Content="Clear" Click="Clear_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="16,10" ColumnSpacing="10" BorderBrush="{ThemeResource RowDividerBrush}" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" /><ColumnDefinition Width="3.2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="0.9*" />
                        <ColumnDefinition Width="1.3*" /><ColumnDefinition Width="1.3*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="0.9*" />
                        <ColumnDefinition Width="0" /><ColumnDefinition Width="1.6*" /><ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="Update" Style="{StaticResource ColumnHeaderStyle}" />
                    <TextBlock Grid.Column="2" Text="Maker" Style="{StaticResource ColumnHeaderStyle}" />
                    <TextBlock Grid.Column="3" Text="Category" Style="{StaticResource ColumnHeaderStyle}" />
                    <TextBlock Grid.Column="4" Text="Current" Style="{StaticResource ColumnHeaderStyle}" />
                    <TextBlock Grid.Column="5" Text="Available" Style="{StaticResource ColumnHeaderStyle}" />
                    <TextBlock Grid.Column="6" Text="Priority" Style="{StaticResource ColumnHeaderStyle}" />
                    <TextBlock Grid.Column="7" Text="Size" Style="{StaticResource ColumnHeaderStyle}" />
                    
                    <TextBlock Grid.Column="9" Text="Status" Style="{StaticResource ColumnHeaderStyle}" />
                </Grid>

                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.FilteredUpdates}" SelectionMode="None" Padding="0,0,0,8">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:UpdateItemViewModel">
                            <Grid Padding="16,10" ColumnSpacing="10" BorderBrush="{ThemeResource RowDividerBrush}" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" /><ColumnDefinition Width="3.2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="0.9*" />
                                    <ColumnDefinition Width="1.3*" /><ColumnDefinition Width="1.3*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="0.9*" />
                                    <ColumnDefinition Width="0" /><ColumnDefinition Width="1.6*" /><ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <CheckBox MinWidth="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind IsInstallable, Mode=OneWay}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" Foreground="{ThemeResource BrandBlueBrush}" />
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" />
                                        <TextBlock Text="{x:Bind StatusMessage, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind StatusMessage, Mode=OneWay}"
                                                   Visibility="{x:Bind vm:Format.VisibleIfText(StatusMessage), Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{x:Bind Manufacturer}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3" Text="{x:Bind CategoryText}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="4" Text="{x:Bind CurrentVersion}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="5" Text="{x:Bind AvailableVersion}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="6" Text="{x:Bind PriorityText}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="7" Text="{x:Bind SizeText}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                
                                <StackPanel Grid.Column="9" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="{x:Bind StateBrush, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind StateText, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind StatusMessage, Mode=OneWay}" />
                                </StackPanel>
                                <Button Grid.Column="10" Background="Transparent" BorderThickness="0" Padding="6" ToolTipService.ToolTip="More options">
                                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="View release notes" Click="ReleaseNotes_Click" Tag="{x:Bind}" IsEnabled="{x:Bind HasReleaseNotes}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A7;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Exclude this update" Click="Exclude_Click" Tag="{x:Bind}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8F8;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                            Visibility="{x:Bind vm:Format.VisibleIfNone(ViewModel.FilteredUpdates.Count), Mode=OneWay}">
                    <FontIcon Glyph="&#xE73E;" FontSize="36" Foreground="{ThemeResource BrandTealBrush}" />
                    <TextBlock Text="Nothing to update here" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Expander Header="Excluded updates" Visibility="{x:Bind vm:Format.VisibleIfAny(ViewModel.ExcludedUpdates.Count), Mode=OneWay}" HorizontalAlignment="Left" MinWidth="420">
                <ItemsControl ItemsSource="{x:Bind ViewModel.ExcludedUpdates}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:UpdateItemViewModel">
                            <Grid ColumnSpacing="12" Padding="0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1" Content="Include again" Click="Include_Click" Tag="{x:Bind}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource AccentButtonStyle}" MinHeight="40" Padding="20,0"
                    Click="InstallSelected_Click" IsEnabled="{x:Bind ViewModel.CanInstallSelected, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE896;" FontSize="16" /><TextBlock Text="{x:Bind ViewModel.InstallSelectedText, Mode=OneWay}" FontWeight="SemiBold" /></StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
