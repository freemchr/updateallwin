<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UpdateAllWin.App.Pages.AutomationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:UpdateAllWin.App.Controls"
    xmlns:vm="using:UpdateAllWin.App.ViewModels">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer>
            <StackPanel Padding="24,20,24,20" Spacing="4" MaxWidth="1000" HorizontalAlignment="Stretch">
                <TextBlock Text="Automation" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="How UpdateAll Win checks for and installs updates in the background. These settings apply to everyone on this PC and need administrator approval to change."
                           Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,0,0,12" />

                <TextBlock Text="Background service" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,4" />
                <controls:SettingRow Header="UpdateAllService" Description="{x:Bind ServiceDescription, Mode=OneWay}" Glyph="&#xE7EF;">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Start" Click="StartService_Click" />
                        <Button Content="Enable" Click="EnableService_Click" />
                        <Button Content="Disable" Click="DisableService_Click" />
                    </StackPanel>
                </controls:SettingRow>

                <TextBlock Text="Schedule" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
                <controls:SettingRow Header="Update scan frequency" Description="{x:Bind ViewModel.NextScanText, Mode=OneWay}" Glyph="&#xE823;">
                    <ComboBox SelectedIndex="{x:Bind ViewModel.Policy.ScanFrequencyIndex, Mode=TwoWay}" MinWidth="180">
                        <ComboBoxItem Content="Manual only" />
                        <ComboBoxItem Content="Daily" />
                        <ComboBoxItem Content="Weekly" />
                    </ComboBox>
                </controls:SettingRow>
                <controls:SettingRow Header="Scan time" Description="Scans that are missed while the PC is off run soon after it starts." Glyph="&#xE916;"
                                     Visibility="{x:Bind vm:Format.Visible(ViewModel.Policy.IsScheduled), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox ItemsSource="{x:Bind Days}" SelectedIndex="{x:Bind ViewModel.Policy.ScanDayIndex, Mode=TwoWay}" MinWidth="140"
                                  Visibility="{x:Bind vm:Format.Visible(ViewModel.Policy.IsWeekly), Mode=OneWay}" />
                        <ComboBox ItemsSource="{x:Bind Hours}" SelectedIndex="{x:Bind ViewModel.Policy.ScanHour, Mode=TwoWay}" MinWidth="110" />
                    </StackPanel>
                </controls:SettingRow>

                <TextBlock Text="Automatic updates" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
                <controls:SettingRow Header="Download updates automatically" Description="Pre-download recommended updates after a scheduled scan so installs are faster." Glyph="&#xE896;">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.Policy.AutoDownload, Mode=TwoWay}" />
                </controls:SettingRow>
                <controls:SettingRow Header="Install drivers automatically" Description="Install approved driver updates after scheduled scans." Glyph="&#xE713;">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.Policy.AutoInstallDrivers, Mode=TwoWay}" />
                </controls:SettingRow>
                <controls:SettingRow Header="Install firmware automatically" Description="Firmware (not BIOS) updates after scheduled scans." Glyph="&#xE964;">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.Policy.AutoInstallFirmware, Mode=TwoWay}" />
                </controls:SettingRow>
                <controls:SettingRow Header="Critical updates only" Description="Only show and install updates the manufacturer marks as critical." Glyph="&#xE7BA;">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.Policy.CriticalOnly, Mode=TwoWay}" />
                </controls:SettingRow>
                <controls:SettingRow Header="BIOS updates need approval" Description="Recommended. BIOS updates are never installed automatically while this is on." Glyph="&#xE950;">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.Policy.BiosApprovalRequired, Mode=TwoWay}" />
                </controls:SettingRow>

                <TextBlock Text="Quiet hours" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
                <controls:SettingRow Header="Quiet hours" Description="No automatic scans, installs or notifications during these hours." Glyph="&#xE708;">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox ItemsSource="{x:Bind Hours}" SelectedIndex="{x:Bind ViewModel.Policy.QuietHoursStart, Mode=TwoWay}" MinWidth="100"
                                  IsEnabled="{x:Bind ViewModel.Policy.QuietHoursEnabled, Mode=OneWay}" />
                        <TextBlock Text="to" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{x:Bind Hours}" SelectedIndex="{x:Bind ViewModel.Policy.QuietHoursEnd, Mode=TwoWay}" MinWidth="100"
                                  IsEnabled="{x:Bind ViewModel.Policy.QuietHoursEnabled, Mode=OneWay}" />
                        <ToggleSwitch IsOn="{x:Bind ViewModel.Policy.QuietHoursEnabled, Mode=TwoWay}" MinWidth="0" />
                    </StackPanel>
                </controls:SettingRow>

                <TextBlock Text="Restarts" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
                <controls:SettingRow Header="Restart reminders" Description="How often to remind you when a restart is needed. UpdateAll Win never restarts without your OK." Glyph="&#xE777;">
                    <ComboBox SelectedIndex="{x:Bind ViewModel.Policy.RestartReminderIndex, Mode=TwoWay}" MinWidth="160">
                        <ComboBoxItem Content="Every hour" />
                        <ComboBoxItem Content="Every 2 hours" />
                        <ComboBoxItem Content="Every 4 hours" />
                        <ComboBoxItem Content="Every 8 hours" />
                        <ComboBoxItem Content="Once a day" />
                    </ComboBox>
                </controls:SettingRow>
                <controls:SettingRow Header="Restart deferral" Description="After this, “Restart later” is no longer offered (reminders continue)." Glyph="&#xE823;">
                    <ComboBox SelectedIndex="{x:Bind ViewModel.Policy.MaxDeferralIndex, Mode=TwoWay}" MinWidth="160">
                        <ComboBoxItem Content="1 day" />
                        <ComboBoxItem Content="2 days" />
                        <ComboBoxItem Content="3 days" />
                        <ComboBoxItem Content="1 week" />
                        <ComboBoxItem Content="No limit" />
                    </ComboBox>
                </controls:SettingRow>

                <TextBlock Text="Excluded updates" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
                <TextBlock Text="Exclude an update from the Available Updates page (••• menu). Excluded updates are never installed."
                           Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.ExcludedUpdates}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:UpdateItemViewModel">
                            <controls:SettingRow Header="{x:Bind Name}" Description="{x:Bind AvailableVersion}" Glyph="&#xE8F8;">
                                <Button Content="Include again" Click="Include_Click" Tag="{x:Bind Key}" />
                            </controls:SettingRow>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Padding="24,12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Discard changes" Click="Discard_Click" />
                <Button Style="{StaticResource AccentButtonStyle}" Click="Save_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xEA18;" FontSize="14" /><TextBlock Text="Save changes" /></StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>
